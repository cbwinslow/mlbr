{
  "mlbr-guardrails": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_guardrails.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
